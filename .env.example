# Copie para .env e troque os valores. Use só letras e números (vão dentro de URLs):
#   openssl rand -hex 24
# NÃO existe senha do mestre aqui: ela é gravada no banco pelo script de operação (veja o README).

# Senha do papel administrativo do Postgres (migrações e script da senha do mestre).
DB_ADMIN_PASSWORD=troque-isto

# Senha do papel da aplicação (cm_app).
DB_APP_PASSWORD=troque-isto-tambem

# Porta publicada no host.
PORT=3000

# 1 = cookie de sessão só por HTTPS (padrão, recomendado).
# 0 = permite HTTP puro, só para rede local sem TLS. A sessão trafega sem criptografia.
COOKIE_SECURE=1

# 1 = há um proxy reverso confiável na frente (Caddy, nginx) que acrescenta X-Forwarded-For.
TRUST_PROXY=0
